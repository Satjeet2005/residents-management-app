// Constraints Prisma cannot express (CHECKs, partial unique index, append-only
// trigger) live in the hand-edited migration SQL. See prisma/README.md.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RESIDENT
  STAFF

  @@map("user_role")
}

enum FlatRelation {
  OWNER
  TENANT
  FAMILY

  @@map("flat_relation")
}

enum EntryType {
  BILL
  LATE_FEE
  PAYMENT
  REVERSAL
  ADJUSTMENT

  @@map("entry_type")
}

enum Direction {
  CHARGE
  PAYMENT

  @@map("direction")
}

enum AttemptStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  RELEASED

  @@map("attempt_status")
}

enum DebitStatus {
  CONFIRMED
  NOT_DEBITED
  UNKNOWN

  @@map("debit_status")
}

enum BankRowState {
  QUEUED
  AUTO_MATCHED
  AWAITING_APPROVAL
  MANUALLY_MATCHED
  IGNORED

  @@map("bank_row_state")
}

enum MatchDecision {
  AUTO
  MANUAL
  REQUEST_APPROVAL
  APPROVED
  REJECTED
  IGNORE
  UNDO

  @@map("match_decision")
}

enum IdentifierType {
  UPI_ID
  NAME

  @@map("identifier_type")
}

enum PayerSource {
  MANUAL
  LEARNED

  @@map("payer_source")
}

enum QueueItemType {
  UNRESOLVED_PAYMENT
  EXCEPTION
  BANK_ROW

  @@map("queue_item_type")
}

enum QueueStatus {
  OPEN
  RESOLVED

  @@map("queue_status")
}

enum ComplaintUrgency {
  CRITICAL
  HIGH
  NORMAL
  LOW

  @@map("complaint_urgency")
}

enum ComplaintStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING_CONFIRMATION
  CLOSED
  REOPENED

  @@map("complaint_status")
}

enum CloseKind {
  CONFIRMED
  AUTO_CLOSED
  DUTY_MANAGER

  @@map("close_kind")
}

enum ComplaintEventType {
  CREATED
  CLASSIFIED
  ASSIGNED
  STATUS_CHANGED
  COMMENT
  REOPENED
  CATEGORY_CORRECTED
  DUPLICATE_LINKED
  ESCALATED
  AFFECTED_TOO
  CLOSED

  @@map("complaint_event_type")
}

enum ClassificationSource {
  RULE
  LLM
  FALLBACK
  MANUAL

  @@map("classification_source")
}

enum OutboxJobType {
  CLASSIFY_COMPLAINT
  SEND_NOTIFICATION
  ESCALATE_PAYMENT
  AUTO_CLOSE_COMPLAINT
  ACCRUE_DAILY

  @@map("outbox_job_type")
}

enum OutboxStatus {
  PENDING
  RUNNING
  DONE
  FAILED

  @@map("outbox_status")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

enum VisitorStatus {
  EXPECTED
  ARRIVED
  DEPARTED
  CANCELLED

  @@map("visitor_status")
}

model Flat {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String @unique
  tower    String
  number   String
  areaSqft Int    @map("area_sqft")

  members         FlatMember[]
  bills           Bill[]
  ledgerEntries   LedgerEntry[]
  paymentAttempts PaymentAttempt[]
  bankRows        BankRow[]
  paymentMatches  PaymentMatch[]
  knownPayers     KnownPayer[]

  complaints        Complaint[]
  complaintAffected ComplaintAffected[]
  visitorPasses     VisitorPass[]

  @@map("flats")
}

model User {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone  String   @unique
  name   String
  role   UserRole
  active Boolean  @default(true)

  memberships        FlatMember[]
  permissions        UserPermission[]
  sessions           Session[]
  createdEntries     LedgerEntry[]
  resolvedAttempts   PaymentAttempt[]
  statementImports   StatementImport[]
  madeDecisions      PaymentMatch[]      @relation("MatchDecidedBy")
  approvedMatches    PaymentMatch[]      @relation("MatchApprover")
  addedPayers        KnownPayer[]
  resolvedQueueItems AccountsQueueItem[]

  assignedCategories ComplaintCategory[]
  complaintsRaised   Complaint[]         @relation("ComplaintRaisedBy")
  complaintsAssigned Complaint[]         @relation("ComplaintAssignee")
  complaintEvents    ComplaintEvent[]
  linksMade          ComplaintLink[]
  notifications      Notification[]
  auditEntries       AuditLog[]

  @@map("users")
}

model FlatMember {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flatId   String       @map("flat_id") @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  relation FlatRelation
  startsOn DateTime     @map("starts_on") @db.Date
  endsOn   DateTime?    @map("ends_on") @db.Date

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([flatId, userId, startsOn])
  @@map("flat_members")
}

model UserPermission {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  permission String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, permission])
  @@map("user_permissions")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("otp_codes")
}

model SocietySetting {
  key   String @id
  value Json

  @@map("society_settings")
}

model Bill {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flatId           String   @map("flat_id") @db.Uuid
  period           DateTime @db.Date
  issuedOn         DateTime @map("issued_on") @db.Date
  dueOn            DateTime @map("due_on") @db.Date
  amountPaise      BigInt   @map("amount_paise")
  areaSqftSnapshot Int      @map("area_sqft_snapshot")
  ratePaisePerSqft Int      @map("rate_paise_per_sqft")

  flat                    Flat             @relation(fields: [flatId], references: [id], onDelete: Restrict)
  ledgerEntries           LedgerEntry[]
  paymentAttempts         PaymentAttempt[]
  ledgerEntriesSameFlat   LedgerEntry[]    @relation("EntryBillSameFlat")
  paymentAttemptsSameFlat PaymentAttempt[] @relation("AttemptBillSameFlat")

  @@unique([flatId, period])
  @@unique([id, flatId])
  @@map("bills")
}

model LedgerEntry {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flatId           String    @map("flat_id") @db.Uuid
  entryType        EntryType @map("entry_type")
  direction        Direction
  amountPaise      BigInt    @map("amount_paise")
  effectiveDate    DateTime  @map("effective_date") @db.Date
  billId           String?   @map("bill_id") @db.Uuid
  paymentAttemptId String?   @map("payment_attempt_id") @db.Uuid
  bankRowId        String?   @map("bank_row_id") @db.Uuid
  reversesEntryId  String?   @unique @map("reverses_entry_id") @db.Uuid
  reference        String?   @unique
  idempotencyKey   String    @unique @map("idempotency_key")
  note             String?
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  flat            Flat            @relation(fields: [flatId], references: [id], onDelete: Restrict)
  bill            Bill?           @relation(fields: [billId], references: [id], onDelete: Restrict)
  paymentAttempt  PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  bankRow         BankRow?        @relation("EntryBankRow", fields: [bankRowId], references: [id], onDelete: Restrict)
  fundedRows      BankRow[]       @relation("RowLedgerEntry")
  reverses        LedgerEntry?    @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      LedgerEntry?    @relation("Reversal")
  createdBy       User?           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  billSameFlat    Bill?           @relation("EntryBillSameFlat", fields: [billId, flatId], references: [id, flatId], onDelete: Restrict)
  attemptSameFlat PaymentAttempt? @relation("EntryAttemptSameFlat", fields: [paymentAttemptId, flatId], references: [id, flatId], onDelete: Restrict)
  rowsSameFlat    BankRow[]       @relation("RowEntrySameFlat")

  @@unique([id, flatId])
  @@map("ledger_entries")
}

model PaymentAttempt {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId           String        @map("bill_id") @db.Uuid
  flatId           String        @map("flat_id") @db.Uuid
  amountPaise      BigInt        @map("amount_paise")
  status           AttemptStatus
  debitStatus      DebitStatus   @default(UNKNOWN) @map("debit_status")
  gatewayReference String?       @unique @map("gateway_reference")
  startedAt        DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  holdStartedAt    DateTime?     @map("hold_started_at") @db.Timestamptz(6)
  holdEndedAt      DateTime?     @map("hold_ended_at") @db.Timestamptz(6)
  escalatedAt      DateTime?     @map("escalated_at") @db.Timestamptz(6)
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolvedById     String?       @map("resolved_by_id") @db.Uuid
  releaseReason    String?       @map("release_reason")

  bill                  Bill                @relation(fields: [billId], references: [id], onDelete: Restrict)
  flat                  Flat                @relation(fields: [flatId], references: [id], onDelete: Restrict)
  resolvedBy            User?               @relation(fields: [resolvedById], references: [id], onDelete: Restrict)
  ledgerEntries         LedgerEntry[]
  queueItems            AccountsQueueItem[]
  billSameFlat          Bill                @relation("AttemptBillSameFlat", fields: [billId, flatId], references: [id, flatId], onDelete: Restrict)
  ledgerEntriesSameFlat LedgerEntry[]       @relation("EntryAttemptSameFlat")

  @@unique([id, flatId])
  @@map("payment_attempts")
}

model StatementImport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  filename     String
  fileSha256   String   @map("file_sha256")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  rowsRead     Int      @map("rows_read")
  notes        String?

  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  rows       BankRow[]

  @@map("statement_imports")
}

model BankRow {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId      String       @map("import_id") @db.Uuid
  rowNumber     Int          @map("row_number")
  txnDate       DateTime     @map("txn_date") @db.Date
  valueDate     DateTime?    @map("value_date") @db.Date
  narrationRaw  String       @map("narration_raw")
  creditPaise   BigInt       @default(0) @map("credit_paise")
  debitPaise    BigInt       @default(0) @map("debit_paise")
  balancePaise  BigInt?      @map("balance_paise")
  dedupeKey     String       @unique @map("dedupe_key")
  parsed        Json         @default("{}")
  state         BankRowState @default(QUEUED)
  flatId        String?      @map("flat_id") @db.Uuid
  ledgerEntryId String?      @map("ledger_entry_id") @db.Uuid
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  import              StatementImport     @relation(fields: [importId], references: [id], onDelete: Restrict)
  flat                Flat?               @relation(fields: [flatId], references: [id], onDelete: Restrict)
  ledgerEntry         LedgerEntry?        @relation("RowLedgerEntry", fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  fundedEntries       LedgerEntry[]       @relation("EntryBankRow")
  matches             PaymentMatch[]
  queueItems          AccountsQueueItem[]
  ledgerEntrySameFlat LedgerEntry?        @relation("RowEntrySameFlat", fields: [ledgerEntryId, flatId], references: [id, flatId], onDelete: Restrict)

  @@unique([importId, rowNumber])
  @@map("bank_rows")
}

model PaymentMatch {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankRowId   String        @map("bank_row_id") @db.Uuid
  decision    MatchDecision
  flatId      String?       @map("flat_id") @db.Uuid
  score       Int?
  reasons     Json          @default("[]")
  candidates  Json          @default("[]")
  decidedById String?       @map("decided_by_id") @db.Uuid
  approverId  String?       @map("approver_id") @db.Uuid
  reason      String?
  decidedAt   DateTime      @default(now()) @map("decided_at") @db.Timestamptz(6)

  bankRow   BankRow @relation(fields: [bankRowId], references: [id], onDelete: Restrict)
  flat      Flat?   @relation(fields: [flatId], references: [id], onDelete: Restrict)
  decidedBy User?   @relation("MatchDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  approver  User?   @relation("MatchApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@map("payment_matches")
}

model KnownPayer {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flatId          String         @map("flat_id") @db.Uuid
  identifierType  IdentifierType @map("identifier_type")
  identifierValue String         @map("identifier_value")
  source          PayerSource
  addedById       String?        @map("added_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  flat    Flat  @relation(fields: [flatId], references: [id], onDelete: Restrict)
  addedBy User? @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([identifierType, identifierValue, flatId])
  @@map("known_payers")
}

model AccountsQueueItem {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemType         QueueItemType @map("item_type")
  bankRowId        String?       @map("bank_row_id") @db.Uuid
  paymentAttemptId String?       @map("payment_attempt_id") @db.Uuid
  status           QueueStatus   @default(OPEN)
  openedAt         DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolvedById     String?       @map("resolved_by_id") @db.Uuid
  note             String?

  bankRow        BankRow?        @relation(fields: [bankRowId], references: [id], onDelete: Restrict)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  resolvedBy     User?           @relation(fields: [resolvedById], references: [id], onDelete: Restrict)

  @@map("accounts_queue_items")
}

model ComplaintCategory {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String  @unique
  name              String
  defaultAssigneeId String? @map("default_assignee_id") @db.Uuid

  defaultAssignee User?            @relation(fields: [defaultAssigneeId], references: [id], onDelete: Restrict)
  complaints      Complaint[]
  classifications Classification[]

  @@map("complaint_categories")
}

model Complaint {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flatId                String           @map("flat_id") @db.Uuid
  raisedById            String           @map("raised_by_id") @db.Uuid
  body                  String
  language              String?
  categoryId            String?          @map("category_id") @db.Uuid
  urgency               ComplaintUrgency @default(NORMAL)
  safetyFlag            Boolean          @default(false) @map("safety_flag")
  status                ComplaintStatus  @default(NEW)
  assigneeId            String?          @map("assignee_id") @db.Uuid
  responseDueAt         DateTime?        @map("response_due_at") @db.Timestamptz(6)
  firstResponseAt       DateTime?        @map("first_response_at") @db.Timestamptz(6)
  pendingConfirmationAt DateTime?        @map("pending_confirmation_at") @db.Timestamptz(6)
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(6)
  closeKind             CloseKind?       @map("close_kind")
  rating                Int?
  reopenCount           Int              @default(0) @map("reopen_count")
  needsReview           Boolean          @default(false) @map("needs_review")
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  flat            Flat                @relation(fields: [flatId], references: [id], onDelete: Restrict)
  raisedBy        User                @relation("ComplaintRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  category        ComplaintCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignee        User?               @relation("ComplaintAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  events          ComplaintEvent[]
  classifications Classification[]
  asPrimary       ComplaintLink[]     @relation("LinkPrimary")
  asDuplicate     ComplaintLink?      @relation("LinkDuplicate")
  affected        ComplaintAffected[]

  @@map("complaints")
}

model ComplaintEvent {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String             @map("complaint_id") @db.Uuid
  eventType   ComplaintEventType @map("event_type")
  actorId     String?            @map("actor_id") @db.Uuid
  payload     Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("complaint_events")
}

model Classification {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String               @map("complaint_id") @db.Uuid
  source      ClassificationSource
  categoryId  String?              @map("category_id") @db.Uuid
  urgency     ComplaintUrgency
  confidence  Decimal?             @db.Decimal(4, 3)
  latencyMs   Int?                 @map("latency_ms")
  outputHash  String?              @map("output_hash")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint          @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  category  ComplaintCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("classifications")
}

model ComplaintLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  primaryId   String   @map("primary_id") @db.Uuid
  duplicateId String   @unique @map("duplicate_id") @db.Uuid
  similarity  Decimal? @db.Decimal(4, 3)
  linkedById  String?  @map("linked_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  primary   Complaint @relation("LinkPrimary", fields: [primaryId], references: [id], onDelete: Restrict)
  duplicate Complaint @relation("LinkDuplicate", fields: [duplicateId], references: [id], onDelete: Restrict)
  linkedBy  User?     @relation(fields: [linkedById], references: [id], onDelete: Restrict)

  @@map("complaint_links")
}

model ComplaintAffected {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  flatId      String   @map("flat_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  flat      Flat      @relation(fields: [flatId], references: [id], onDelete: Restrict)

  @@unique([complaintId, flatId])
  @@map("complaint_affected")
}

model OutboxJob {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType        OutboxJobType @map("job_type")
  payload        Json          @default("{}")
  status         OutboxStatus  @default(PENDING)
  attempts       Int           @default(0)
  runAfter       DateTime      @default(now()) @map("run_after") @db.Timestamptz(6)
  idempotencyKey String        @unique @map("idempotency_key")
  lastError      String?       @map("last_error")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt     DateTime?     @map("finished_at") @db.Timestamptz(6)

  @@map("outbox_jobs")
}

model Notification {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId    String             @map("recipient_id") @db.Uuid
  kind           String
  body           Json               @default("{}")
  status         NotificationStatus @default(PENDING)
  idempotencyKey String             @unique @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(6)
  readAt         DateTime?          @map("read_at") @db.Timestamptz(6)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("audit_log")
}

model VisitorPass {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flatId      String        @map("flat_id") @db.Uuid
  visitorName String        @map("visitor_name")
  expectedAt  DateTime      @map("expected_at") @db.Timestamptz(6)
  purpose     String?
  status      VisitorStatus @default(EXPECTED)

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Restrict)

  @@map("visitor_passes")
}
