# Copy to .env for local runs. Placeholders only; never commit real values.
DATABASE_URL=postgresql://township:township_local_only@localhost:5436/township
SESSION_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-another-long-random-string
DEMO_MODE=true
# Signs the payment gateway's webhook events. At least 32 characters in production, and not this placeholder (the app refuses it).
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
LLM_API_KEY=replace-with-your-llm-api-key
SHOW_DESIGN_PAGE=false
# Demo only, optional: freeze "today" for dues, days overdue, visitors and reply times to this date (12:00 India time),
# so the sample numbers in the client brief can be reproduced. Leave it unset (commented) to use the real date.
# Never set it on a live deployment. Login and sessions always use the real clock.
# DEMO_AS_OF=2026-10-27
