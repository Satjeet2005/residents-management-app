# Copy to .env for local runs. Placeholders only; never commit real values.
DATABASE_URL=postgresql://township:township_local_only@localhost:5436/township
# Host port of the local database container (docker-compose.yml reads it; default 5436). If you change it, change the port in DATABASE_URL to match.
DB_PORT=5436
SESSION_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-another-long-random-string
DEMO_MODE=true
# Signs the payment gateway's webhook events. At least 32 characters in production, and not this placeholder (the app refuses it).
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
LLM_API_KEY=replace-with-your-llm-api-key
# Complaint classifier providers, System One protocol (D140). A provider is used when its URL and key are set; with none set the keyword
# fallback answers. The model is OPTIONAL (D144): leave it out and the request carries no `model` field, so the provider chooses its default. Placeholders only: the real keys live in your own .env and in the Vercel dashboard, nowhere else.
# JEV_PRIMARY_URL=https://opencode.ai/inference/systemone/v1/systemone
# JEV_PRIMARY_MODEL=optional-model-name-for-this-provider
# JEV_PRIMARY_KEY=replace-with-the-primary-key
# JEV_SECONDARY_URL=https://jevmodel.app/api/v1/systemone
# JEV_SECONDARY_MODEL=optional-model-name-for-this-provider
# JEV_SECONDARY_KEY=replace-with-the-secondary-key
# Optional: JEV_TIMEOUT_MS (500 to 4000, default 3000), JEV_DAILY_CAP per provider (1 to 100000, default 300),
# JEV_BREAKER_FAILURES (default 3), JEV_BREAKER_COOLDOWN_SECONDS (default 120).
SHOW_DESIGN_PAGE=false
# Demo only, optional: freeze "today" for dues, days overdue, visitors and reply times to this date (12:00 India time),
# so the sample numbers in the client brief can be reproduced. Leave it unset (commented) to use the real date.
# Never set it on a live deployment. Login and sessions always use the real clock.
# DEMO_AS_OF=2026-10-27
# Error log (D135, D136). LOGS_DATABASE_URL is the read-only logs role of `npm run logs:errors`: it is for the DEVELOPER'S MACHINE ONLY and must NEVER be set in Vercel.
# LOGS_DATABASE_URL=postgresql://township_logs:replace-with-the-logs-role-password@localhost:5436/township
# Optional: at least 32 characters enables GET /api/ops/error-test (a plain 404 without it). Set it in the Vercel dashboard only, never in a file.
# OPS_TEST_TOKEN=replace-with-a-long-random-string-of-32-or-more-characters
